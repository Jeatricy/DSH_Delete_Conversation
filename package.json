{
  "name": "dsh-delete-conversation",
  "version": "1.0.0",
  "description": "Permanently delete DSH conversations from a button beside Archive.",
  "type": "module",
  "license": "MIT",
  "os": [
    "win32"
  ],
  "author": "Jeatricy",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeatricy/DSH_Delete_Conversation.git"
  },
  "homepage": "https://github.com/Jeatricy/DSH_Delete_Conversation#readme",
  "bugs": "https://github.com/Jeatricy/DSH_Delete_Conversation/issues",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/host-adapter.js",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check dist/client.js && node --check src/host-adapter.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
